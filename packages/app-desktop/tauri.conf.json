{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "wiwipaccer",
	"version": "0.1.0",
	"identifier": "gay.kiwin.wiwipaccer",
	"build": {
		"beforeDevCommand": {
			"script": "trunk serve",
			"cwd": "../app-frontend"
		},
		"devUrl": "http://localhost:3000",
		"beforeBuildCommand": {
			"script": "trunk build",
			"cwd": "../app-frontend"
		},
		"frontendDist": "../../target/trunk"
	},
	"app": {
		"withGlobalTauri": true,
		"security": {
			"csp": null,
			"capabilities": [
				{
					"identifier": "h",
					"webviews": ["*"],
					"windows": ["*"],
					"permissions": ["core:window:allow-start-dragging"]
				}
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
