// todo put a version here maybe?
package wiwi:wiwipaccer-provider-plugin;

world plugin {
	import api;
	export imp;
}

interface types {
	record plugin-meta {
		/// Namespace this plugin is part of (required)
		///
		/// This should be unique across plugin makers. Try reversed internet
		/// domain name if not sure.
		ns: string,

		/// ID of this plugin (required)
		///
		/// This must be unique within a namespace (which should not be an issue
		/// if you know your namespace to be unique).
		id: string,

		/// Version of this plugin, a semver string (optional, but highly recommended)
		version: option<string>

		// /// List of authors of this plugin (optional)
		// ///
		// /// These should be either just the name, or name followed by email
		// /// surrounded in angle brackets (`<` and `>`).
		// authors: list<plugin-author>
	}

	// // do we want to create a record for name, email, etc?
	// // probably, but later
	// type plugin-author = string;

	// /// binary data
	// type binary = list<u8>;

	resource run-ctx {
		get-assets: func() -> result<list<asset>, error>;
		// get-block-id: func() -> string;
		get-manifest-key: func(key: string) -> manifest-key;
	}

	variant manifest-key {
		none,
		%bool(bool),
		int(s64),
		float(f64),
		str(string),
		array(list<manifest-sub-item>),
		map(manifest-map)
	}

	resource manifest-map {
		get: func(key: manifest-sub-item) -> manifest-sub-item;
	}

	variant manifest-sub-item {
		%bool(bool),
		int(s64),
		float(f64),
		str(string)
	}

	resource asset {
		/// Provides relative path within the provider directory
		path: func() -> string;

		/// Reads all the bytes of the file, or all the remaining bytes if some
		/// have already been read
		read-all: func() -> result<list<u8>, error>;

		// /// Reads up to the next `limit` bytes
		// read-next: func(limit: u64) -> result<list<u8>, error>;
	}

	record pack-entries {
		dummy-todo-remove-me: s64
	}

	resource error {
		from-str: static func(s: string) -> error;

		/// Returns debug string
		dbg: func() -> string;
	}
}

interface api {
}

interface imp {
	use types.{
		run-ctx,
		error,
		pack-entries,
		plugin-meta
	};

	meta: func() -> plugin-meta;

	/// Run the plugin
	run: func(input: run-ctx) -> result<pack-entries, error>;
}
